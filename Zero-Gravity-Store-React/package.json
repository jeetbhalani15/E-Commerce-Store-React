{
  "name": "zero-gravity-store",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "axios": "^1.6.7",
    "dayjs": "^1.11.10",
    "jwt-decode": "^3.1.2",
    "jwt-encode": "^1.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "react-router-dom": "^6.22.1",
    "react-scripts": "5.0.1",
    "react-spinners": "^0.13.8",
    "react-toastify": "^10.0.4",
    "uuid": "^9.0.1",
    "web-vitals": "^3.5.2"
  },
  "devDependencies": {
    "miragejs": "^0.1.48",
    "mockman-js": "^1.1.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "set NODE_OPTIONS=--openssl-legacy-provider && GENERATE_SOURCEMAP=false react-scripts build",
    "build:mac": "export NODE_OPTIONS=--openssl-legacy-provider && GENERATE_SOURCEMAP=false react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "lint": "eslint src/**/*.{js,jsx}",
    "format": "prettier --write src/**/*.{js,jsx,css,md}"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
